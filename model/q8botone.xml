    <geom name="floor" type="plane" size="0 0 0.05" material="floor" contype="1" conaffinity="6"/>

    <!-- A test stand: holds the chassis with its servo shafts 110 mm up,
         out of any foot's reach. Off unless its weld (in <equality>) is on. -->
    <body name="stand" mocap="true" pos="0 0 0.11">
      <geom class="stand" fromto="0 0 -0.01135 0 0 -0.107" size="0.008"/>
      <geom class="stand" fromto="0 0 -0.107 0 0 -0.11" size="0.035"/>
    </body>

    <body name="chassis" pos="0 0 0.0419437">
