#!/bin/sh
# Checks generated/bundled files against their sources, for what's staged:
# - requirements.txt must match pyproject.toml (it's generated - see
#   update_requirements.py). Runs when either file is in the commit.
# - q8bot/firmware/*.bin must be the latest firmware release (see
#   check_firmware_bins.py). Runs when a .bin is in the commit. This is the
#   check that protects installs from GitHub: the build-time one is skipped
#   there, with no q8botone-firmware next to the source to compare against.
# `git commit --no-verify` skips both. Enabled per clone with:
#     git config core.hooksPath .githooks

staged=$(git diff --cached --name-only)
check_requirements=$(echo "$staged" | grep -xE 'pyproject\.toml|requirements\.txt')
check_firmware=$(echo "$staged" | grep -xE 'q8bot/firmware/[^/]*\.bin')
[ -n "$check_requirements$check_firmware" ] || exit 0

root=$(git rev-parse --show-toplevel)
python=python
for candidate in "$root/venv/Scripts/python.exe" "$root/venv/bin/python"; do
    [ -x "$candidate" ] && python=$candidate && break
done

if [ -n "$check_requirements" ]; then
    "$python" "$root/update_requirements.py" --check-staged || {
        echo "Commit stopped: requirements.txt is out of date (see above)." >&2
        exit 1
    }
fi

if [ -n "$check_firmware" ]; then
    "$python" "$root/check_firmware_bins.py" --staged || {
        echo "Commit stopped: the staged firmware isn't the latest release (see above)." >&2
        exit 1
    }
fi
